; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Unreliable Instruction"
config/version="0.1"
config/tags=PackedStringArray("template")
run/main_scene="res://src/scene/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://asset/ui/project-icon.png"

[autoload]

EnumAutoload="*res://src/singleton/enum_autoload.gd"
GameManager="*res://src/singleton/GameManager.tscn"
SoundManager="*uid://banokm23tjqmc"
DialogueManager="*uid://c3rodes2l3gxb"

[debug]

gdscript/warnings/unused_signal=0

[dialogue_manager]

runtime/balloon_path="res://src/ui/balloon.tscn"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

